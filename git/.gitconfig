[user]
	name = Balša Šarenac
	email = sarenac.balsa@proton.me
[alias]
	st = status
	br = branch
	graph = log --oneline --graph --decorate --all
	co = checkout
	ci = commit
	sw = switch
	swc = switch -c
    stat = status -sb
	last = log -1 HEAD
	unstage = reset HEAD --
    branches = "!sh -c \"git checkout $(git for-each-ref --sort='-authordate:iso8601' --format=' %(authordate:relative)%09%(refname:short)' refs | pick | cut -f2)\""
    current = !git branch -r --merged | grep -q $1 && echo Incorporates $1 || echo Out of date from $1 && :
    recent = "for-each-ref --count=10 --sort=-committerdate refs/heads/ --format='%(refname:short)'"
    recap = "log --all --oneline --no-merges --author=\"Balša Šarenac\""
	pf = push --force-with-lease
    dft = difftool
     dlog = "!f() { : git log ; GIT_EXTERNAL_DIFF=difft git log -p --ext-diff $@; }; f"
	append = town append
	contribute = town contribute
	diff-parent = town diff-parent
	hack = town hack
	kill = town kill
	observe = town observe
	park = town park
	prepend = town prepend
	propose = town propose
	rename-branch = town rename-branch
	repo = town repo
	set-parent = town set-parent
	ship = town ship
	sync = town sync
	lg = log --graph --oneline --decorate --all
	undo = reset HEAD~1 --mixed
	amend = commit --amend

[core]
	editor = nvim
[init]
	defaultbranch = master
[color]
	ui = auto
[diff]
    external = difft
    #tool = nvimdiff
    tool = difftastic
[difftool "difftastic"]
    cmd = "difftastic \"$LOCAL\" \"$REMOTE\""
[pager]
    difftool = true
#[difftool "nvimdiff"]
    #cmd = "nvim -d -u ~/.vimrc \"$LOCAL\" \"$REMOTE\""
[difftool]
	prompt = false
