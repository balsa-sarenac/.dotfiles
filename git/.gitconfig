[user]
	name = Balša Šarenac
	email = sarenac.balsa@proton.me
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII7xbQxoh+xrkTMksKzGi7AW4QpGFTN4LgDFVldzrXrU
[alias]
	st = status
	br = branch
	graph = log --oneline --graph --decorate --all
	co = checkout
	ci = commit
	sw = switch
	swc = switch -c
    stat = status -sb
	last = log -1 HEAD
	unstage = reset HEAD --
    branches = "!sh -c \"git checkout $(git for-each-ref --sort='-authordate:iso8601' --format=' %(authordate:relative)%09%(refname:short)' refs | pick | cut -f2)\""
    current = !git branch -r --merged | grep -q $1 && echo Incorporates $1 || echo Out of date from $1 && :
    recent = "for-each-ref --count=10 --sort=-committerdate refs/heads/ --format='%(refname:short)'"
    recap = "log --all --oneline --no-merges --author=\"Balša Šarenac\""
	pf = push --force-with-lease
    dft = difftool
     dlog = "!f() { : git log ; GIT_EXTERNAL_DIFF=difft git log -p --ext-diff $@; }; f"
	lg = log --graph --oneline --decorate --all
	undo = reset HEAD~1 --mixed
	amend = commit --amend

[core]
	editor = nvim
[init]
	defaultbranch = trunk
[color]
	ui = auto
[pull]
	rebase = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = false

[core]
pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    #dark = true      # or light = true, or omit for auto-detection

[merge]
    conflictStyle = zdiff3
