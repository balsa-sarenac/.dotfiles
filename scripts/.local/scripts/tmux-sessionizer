#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.fzf/bin:$PATH"

if [ $# -eq 1 ]; then
    selected="$1"
else
    selected=$(find "$HOME/oll" -mindepth 1 -maxdepth 1 -type d -not -name '.*' \
        | sort | fzf --prompt='project> ')
fi

[ -z "$selected" ] && exit 0

name=$(basename "$selected" | tr '.' '_')

tmux has-session -t "=$name" 2>/dev/null || tmux new-session -ds "$name" -c "$selected"

if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$name"
else
    tmux attach -t "=$name"
fi
