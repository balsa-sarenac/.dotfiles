SESH="oll-portal"

cd ~/oll/platform/portal/oll/portal/ || exit

if ! tmux has-session -t $SESH 2>/dev/null; then
    tmux new-session -d -s $SESH -n "nvim"

    tmux send-keys -t $SESH:nvim "nvim ." C-m

    tmux new-window -t $SESH -n "server"
    tmux send-keys -t $SESH:server "export DJANGO_SETTINGS_MODULE=oll.portal.portalsite.settings.local_settings
" C-m
    tmux send-keys -t $SESH:server "source ~/oll/platform/.venv/bin/activate" C-m
    tmux send-keys -t $SESH:server "python manage.py runserver" C-m

    tmux new-window -t $SESH -n "portal"

fi

tmux a -t $SESH
