SESH="oll-dev"

cd ~/oll/platform || exit

if ! tmux has-session -t $SESH 2>/dev/null; then
    tmux new-session -d -s $SESH -n "nvim"

    tmux send-keys -t $SESH:nvim "nvim ." C-m
    tmux send-keys -t $SESH:nvim ":e core/oll/core" C-m

    tmux new-window -t $SESH -n "platform"
    tmux send-keys -t $SESH:platform "source ~/oll/platform/.venv/bin/activate" C-m

fi

tmux a -t $SESH
